MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=SyncWrite
JWT_SECRET=your_jwt_secret_here
PORT=5000
NODE_ENV=development
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:5173
# Optional — enables Google sign-in (POST /auth/google). Must match the client's
# VITE_GOOGLE_CLIENT_ID. Get one at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
